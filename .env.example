# Production — used by deploy-aiverse-frontend.ps1
VITE_API_BASE_URL=https://func-aiverse-backend-dwgpguatgadjezae.centralindia-01.azurewebsites.net/api

# Development copy: see .env.dev (used by deploy-dev-aiverse-frontend.ps1)
# VITE_API_BASE_URL=https://dev-func-aiverse-backend-gwgbg2chdqcgdmhw.centralindia-01.azurewebsites.net/api

# Local dev uses Vite proxy at /api automatically (avoids browser CORS errors).
# Proxy target is derived from VITE_API_BASE_URL; override with VITE_API_PROXY_TARGET if needed.
# Set VITE_API_USE_DIRECT_URL=true only if you need to call Azure directly.
# VITE_API_USE_DIRECT_URL=false

# Leave empty until you receive the Azure Function key.
# Mail will send through API only after this value is set.
VITE_EMAIL_API_KEY=

# Backend email function name (change only if your API uses a different route)
VITE_REQUEST_DEMO_EMAIL_ENDPOINT=send-demo-request

# Contact form recipient email
VITE_CONTACT_EMAIL=info@aiverse.com

# Newsletter subscription recipient email (optional)
VITE_NEWSLETTER_EMAIL=info@aiverse.com

# Admin portal credentials (comma-separated emails, one shared password)
VITE_ADMIN_EMAILS=sakshi@espire.com,admin@aiverse.com
VITE_ADMIN_PASSWORD=Admin@123

# Optional: backend endpoint to list demo requests for admin dashboard
VITE_GET_DEMO_REQUESTS_ENDPOINT=get-demo-requests
